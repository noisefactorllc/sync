<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Camera extensions must run in the App Sandbox. Applied to the
       extension executable and its bundle at signing time. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- The CMIO validator requires CMIOExtensionMachServiceName to be
       prefixed by one of these groups; a bare Team ID prefix is rejected
       with "invalid mach service name or is not signed". Team-ID-prefixed
       groups need no provisioning profile on macOS. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TX27BNWUG9.io.noisefactor.sync</string>
  </array>
</dict>
</plist>
