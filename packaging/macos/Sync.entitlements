<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Lets Sync.app activate the bundled Sync Camera system extension.
       Applied to the Sync executable and the app bundle at signing time by
       the release harness; local unsigned builds do not use it. -->
  <key>com.apple.developer.system-extension.install</key>
  <true/>
  <!-- macOS matches a restricted entitlement against the embedded
       provisioning profile by application and team identifier. Xcode adds
       these two automatically; codesign does not. -->
  <key>com.apple.application-identifier</key>
  <string>TX27BNWUG9.io.noisefactor.sync</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TX27BNWUG9</string>
</dict>
</plist>
