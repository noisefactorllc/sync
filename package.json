{
  "name": "sync",
  "private": true,
  "description": "Low-latency bridge between browser renderers and native video ecosystems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noisefactorllc/sync.git"
  },
  "type": "module",
  "scripts": {
    "package:sdk": "node scripts/package-sdk.mjs",
    "examples": "node examples/server.mjs",
    "test:sdk": "node --test --test-timeout=30000 test/browser/*.test.js test/packaging/sdk-package.test.js",
    "test:meta": "node --test --test-timeout=30000 test/meta/*.test.js",
    "test:unit": "node --test --test-timeout=30000 test/meta/*.test.js test/browser/*.test.js test/soak/*.test.js test/soak/lib/*.test.js test/acceptance/*.test.mjs",
    "test:browser": "node --test --test-timeout=30000 test/browser/*.test.js",
    "test:protocol": "node --test --test-timeout=30000 test/browser/protocol.test.js",
    "test:integration": "node --test --test-timeout=30000 test/integration/loopback.test.js && npm run test:integration:soak",
    "test:integration:soak": "node --test --test-concurrency=1 --test-timeout=180000 test/integration/daemon-memory-soak.test.js",
    "test:integration:linux": "node --test --test-timeout=45000 test/integration/linux-daemon-control.test.js",
    "test:packaging": "node --test --test-timeout=30000 test/packaging/*.test.js",
    "test:packaging:linux": "node --test --test-timeout=30000 test/packaging/linux-package.test.js",
    "test:linux:containers": "scripts/test-linux-containers.sh",
    "test:acceptance:unit": "node --test --test-timeout=30000 test/acceptance/*.test.mjs",
    "test:acceptance:interop": "node test/acceptance/interoperability.mjs",
    "test:acceptance:examples": "node test/acceptance/interoperability-examples.mjs",
    "test:soak": "node test/acceptance/daemon-memory-soak.mjs",
    "test:soak:unit": "node --test --test-timeout=30000 test/soak/*.test.js test/soak/lib/*.test.js",
    "test:soak:long": "node test/soak/run.mjs"
  }
}
